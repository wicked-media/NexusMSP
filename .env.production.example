# Copy to .env beside docker-compose.production.yml. Never commit real values.
MONGO_USERNAME=nexusmsp
MONGO_PASSWORD=replace-with-a-long-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-bytes
NEXUS_SECRET_ENCRYPTION_KEY=replace-with-a-dedicated-random-encryption-key
NEXUS_DMARC_RECEIVER_TOKEN=replace-with-a-long-random-receiver-token
NEXUS_DNS_RESOLVERS=1.1.1.1,8.8.8.8
NEXUS_MAIL_SHIELD_CLIENT_SECRET=store-in-your-deployment-secret-manager
CORS_ORIGINS=https://nexus.example.com
NEXUS_HTTP_PORT=8080
NEXUS_MALWARE_SCAN_TIMEOUT_SECONDS=30
NEXUS_GRAFANA_BIND_HOST=127.0.0.1
NEXUS_GRAFANA_PORT=3001
NEXUS_GRAFANA_ADMIN_USER=admin
NEXUS_GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-dashboard-password
NEXUS_ALERT_WEBHOOK_URL=https://on-call.example.com/nexus-alerts
NEXUS_OBSERVABILITY_INGEST_TOKEN=replace-with-a-separate-long-random-token

# Optional: AI features remain disabled when this value is empty.
OPENAI_API_KEY=
