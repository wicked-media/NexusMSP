[Unit]
Description=Nexus OS Edge companion
Documentation=https://nexus.invalid/docs/nexus-os-edge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nexus-edge
Group=nexus-edge
Environment=NEXUS_EDGE_STATE_PATH=/var/lib/nexus-edge/state.json
EnvironmentFile=-/etc/nexus-edge/edge.env
ExecStart=/usr/local/libexec/nexus-edge
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexus-edge
UMask=0077

[Install]
WantedBy=multi-user.target
