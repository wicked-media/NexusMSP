FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system nexus && adduser --system --ingroup nexus nexus
COPY backend/requirements.txt ./
RUN python -m pip install --upgrade pip && pip install -r requirements.txt

COPY --chown=nexus:nexus backend/app ./app
COPY --chown=nexus:nexus backend/server.py backend/worker.py ./
# Agent installers are generated by the API, so production images must carry
# the signed service, Client Chat and user-session tray binaries.
COPY --chown=nexus:nexus agent/dist ./agent/dist
RUN mkdir -p /app/data/agent-installers /app/uploads && chown -R nexus:nexus /app

USER nexus
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=4)"

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
