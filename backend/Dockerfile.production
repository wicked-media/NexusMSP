FROM golang:1.22.12-bookworm AS agent-build

WORKDIR /src/agent

# Resolve dependencies before copying the implementation so normal source-only
# changes can reuse this layer. The production image builds the exact Windows
# service and user-session companions it distributes; it never trusts a
# developer's ignored local agent/dist directory.
COPY agent/go.mod agent/go.sum ./
RUN go mod download

COPY agent ./

ARG NEXUS_AGENT_VERSION=0.1.11-endpoint-readiness

RUN mkdir -p /out \
    && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags "-s -w -X main.Version=${NEXUS_AGENT_VERSION}" -o /out/nexus-agent.exe ./cmd/nexus-agent \
    && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags "-s -w -X main.Version=${NEXUS_AGENT_VERSION}" -o /out/nexus-client-chat.exe ./cmd/nexus-chat \
    && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags "-s -w -H=windowsgui -X main.Version=${NEXUS_AGENT_VERSION}" -o /out/nexus-agent-tray.exe ./cmd/nexus-tray


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system nexus && adduser --system --ingroup nexus nexus
COPY backend/requirements.txt ./
RUN python -m pip install --upgrade pip && pip install -r requirements.txt

COPY --chown=nexus:nexus backend/app ./app
COPY --chown=nexus:nexus backend/server.py backend/worker.py ./
# Agent installers are generated by the API. Build their service and both
# user-session companions in the trusted build stage rather than copying an
# ignored, potentially stale local artifact directory into production.
COPY --from=agent-build --chown=nexus:nexus /out/nexus-agent.exe ./agent/dist/nexus-agent.exe
COPY --from=agent-build --chown=nexus:nexus /out/nexus-client-chat.exe ./agent/dist/nexus-client-chat.exe
COPY --from=agent-build --chown=nexus:nexus /out/nexus-agent-tray.exe ./agent/dist/nexus-agent-tray.exe
RUN mkdir -p /app/data/agent-installers /app/uploads /app/private_uploads && chown -R nexus:nexus /app

USER nexus
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=4)"

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
