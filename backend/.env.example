MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nexusops
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-production-secret
NEXUS_SECRET_ENCRYPTION_KEY=replace-with-a-separate-long-random-production-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
NEXUS_RUN_BACKGROUND_WORKERS=true

# Public authentication abuse guard. Only trust proxy headers when the ingress
# is controlled and overwrites X-Forwarded-For / X-Real-IP.
NEXUS_TRUST_PROXY_HEADERS=false
NEXUS_LOGIN_WINDOW_SECONDS=300
NEXUS_LOGIN_IDENTITY_ATTEMPTS=8
NEXUS_LOGIN_IP_ATTEMPTS=30

# Optional AI features. Without this key, core MSP features still run and AI
# actions return a clear configuration message.
OPENAI_API_KEY=
NEXUS_AI_MODEL=gpt-5.6-terra

# Required only when receiving Stripe webhook events.
STRIPE_WEBHOOK_SECRET=

# Optional NexusOps Agent settings
NEXUS_AGENT_VERSION=0.1.10-signed-commands
NEXUS_TRUST_MTLS_PROXY_HEADER=false
NEXUS_AGENT_BINARY=/app/agent/dist/nexus-agent.exe
# Directory for locally generated agent installers. Defaults to
# backend/data/agent-installers when omitted.
NEXUS_AGENT_INSTALLER_DIR=

# Optional Supabase service integration. The service-role key belongs only in
# backend environment configuration; never expose it to the browser or Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
